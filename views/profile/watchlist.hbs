<div class="container mt-4">
  <h2 class="mb-4">Khóa học yêu thích</h2>

  {{#if courses.length}}

    {{!-- ======= NHÓM: ĐÃ ĐĂNG KÝ ======= --}}
    <h4 class="mt-2 mb-3">Đã đăng ký</h4>
    <div class="row">
      {{#each courses}}
        {{#if this.is_enrolled}}
          <div class="col-md-4 mb-4">
            <div class="card h-100">
              <img src="{{this.thumbnail_url}}" class="card-img-top" style="height:160px;object-fit:cover;" alt="{{this.title}}">
              <div class="card-body">
                <div class="d-flex justify-content-between align-items-start mb-2">
                  <h5 class="card-title mb-0">{{this.title}}</h5>
                  <form method="POST" action="/profile/watchlist/remove/{{this.course_id}}">
                    <button class="btn btn-link p-0" title="Xóa khỏi yêu thích">
                      <i class="fas fa-heart" style="color:red;"></i>
                    </button>
                  </form>
                </div>

                <p class="text-muted small mb-2"><i class="fas fa-user-tie me-1"></i> {{this.instructor_name}}</p>
                <p class="text-muted small mb-2"><i class="fas fa-folder me-1"></i> {{this.category_name}}</p>
                <p class="text-muted small mb-3"><i class="fas fa-book-open me-1"></i> {{this.total_lectures}} bài học</p>

                <div class="progress mb-2" style="height:8px;">
                  <div class="progress-bar bg-success" style="width: {{this.progress}}%;" aria-valuenow="{{this.progress}}" aria-valuemin="0" aria-valuemax="100"></div>
                </div>
                <p class="small text-center text-muted mb-3">Hoàn thành: {{this.progress}}%</p>

                <div class="d-flex flex-column gap-2">
                  <a href="/courses/{{this.course_id}}" class="btn btn-primary">
                    <i class="fas fa-play-circle me-1"></i> Tiếp tục học
                  </a>
                  <small class="text-muted text-center">Đăng ký: {{formatDate this.enrolled_at}}</small>
                </div>
              </div>
            </div>
          </div>
        {{/if}}
      {{/each}}
    </div>

    {{!-- ======= NHÓM: CHƯA ĐĂNG KÝ ======= --}}
    <h4 class="mt-4 mb-3">Chưa đăng ký</h4>
    <div class="row">
      {{#each courses}}
        {{#unless this.is_enrolled}}
          <div class="col-md-4 mb-4">
            <div class="card h-100">
              <img src="{{this.thumbnail_url}}" class="card-img-top" style="height:160px;object-fit:cover;" alt="{{this.title}}">
              <div class="card-body">
                <div class="d-flex justify-content-between align-items-start mb-2">
                  <h5 class="card-title mb-0">{{this.title}}</h5>
                  <form method="POST" action="/profile/watchlist/remove/{{this.course_id}}">
                    <button class="btn btn-link p-0" title="Xóa khỏi yêu thích">
                      <i class="fas fa-heart" style="color:red;"></i>
                    </button>
                  </form>
                </div>

                <p class="text-muted small mb-2"><i class="fas fa-user-tie me-1"></i> {{this.instructor_name}}</p>
                <p class="text-muted small mb-2"><i class="fas fa-folder me-1"></i> {{this.category_name}}</p>

                {{!-- Giá hiển thị an toàn, không NaN --}}
                <p class="text-danger fw-bold mb-3">
                  {{#if this.discount_price}}
                    {{formatPrice this.discount_price}} ₫
                    {{#if this.price}}
                      <span class="text-muted text-decoration-line-through">{{formatPrice this.price}} ₫</span>
                    {{/if}}
                  {{else if this.price}}
                    {{formatPrice this.price}} ₫
                  {{else}}
                    <span class="text-muted">Miễn phí</span>
                  {{/if}}
                </p>

                <div class="d-flex justify-content-between">
                  <a href="/courses/{{this.course_id}}" class="btn btn-outline-primary">Xem chi tiết</a>
                  <form method="POST" action="/enrollments/{{this.course_id}}/enroll">
                    <button type="submit" class="btn btn-primary">Đăng ký học</button>
                  </form>
                </div>
              </div>
            </div>
          </div>
        {{/unless}}
      {{/each}}
    </div>

  {{else}}
    <div class="text-center py-5">
      <i class="fas fa-heart fa-4x text-muted mb-3"></i>
      <h4>Chưa có khóa học yêu thích</h4>
      <a href="/#courses" class="btn btn-primary mt-3">Khám phá khóa học</a>
    </div>
  {{/if}}
</div>

<link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.4/css/all.min.css" rel="stylesheet">
