<section class="auth-hero">
  <div class="auth-container">
    <!-- Brand -->
    <div class="brand text-center mb-4">
      <div class="brand-icon mb-3">
        <i class="bi bi-mortarboard"></i>
      </div>
      <h1 class="brand-title">Online Academy</h1>
      <p class="brand-sub">Learn and teach with passion</p>
    </div>

    <!-- Card -->
    <div class="auth-card">
      <!-- Tabs -->
      <div class="tabs d-flex justify-content-around mb-4 border-bottom">
        <button class="tab active border-0 bg-transparent fw-semibold pb-2">Login</button>
        <button class="tab border-0 bg-transparent fw-semibold pb-2" onclick="location.href='/auth/signup'">Sign Up</button>
      </div>

      <!-- LOGIN FORM -->
      <form class="pane show" method="post" action="/auth/login">
        {{#if error}}
          <div class="alert alert-danger small text-center mb-3">{{error}}</div>
        {{/if}}

        <label class="field mb-3 w-100">
          <span>Email</span>
          <div class="control input-group">
            <span class="input-group-text"><i class="bi bi-envelope"></i></span>
            <input type="email" name="email" placeholder="Enter your email" class="form-control" required value="{{email}}">
          </div>
        </label>

        <label class="field mb-3 w-100">
          <span>Password</span>
          <div class="control input-group">
            <span class="input-group-text"><i class="bi bi-lock"></i></span>
            <input type="password" name="password" placeholder="Enter your password" class="form-control" required>
          </div>
        </label>

        <div class="text-end mb-3">
          <a href="#" data-bs-toggle="modal" data-bs-target="#forgotModal" class="small text-decoration-none fw-semibold">Forgot password?</a>
        </div>

        <button class="btn btn-primary w-100 fw-semibold rounded-3 py-2" type="submit">Login</button>
      </form>

      <!-- Divider -->
      <div class="d-flex align-items-center gap-2 my-3">
        <hr class="flex-grow-1 m-0"/>
        <span class="text-muted small">Hoặc</span>
        <hr class="flex-grow-1 m-0"/>
      </div>

      <!-- Google button -->
      <div class="pb-3">
        <a href="/auth/google" class="btn w-100 d-flex align-items-center justify-content-center gap-2 fw-semibold">
          <img src="https://www.svgrepo.com/show/355037/google.svg" width="18" height="18" alt="Google">
          Login with Google
        </a>
      </div>

      <div class="small text-center mt-3">
        Don't have an account? <a href="/auth/signup" class="fw-semibold">Sign Up</a>
      </div>
    </div>
  </div>
</section>

<!-- Forgot Password Modal -->
<div class="modal fade" id="forgotModal" tabindex="-1" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content p-4 rounded-4 border-0 shadow-sm">
      <h4 class="text-center mb-3 fw-bold">Forgot Password</h4>
      <p class="text-muted small text-center mb-3">
        Enter your email and we’ll send you a reset link.
      </p>

      <form id="forgotForm">
        <div class="mb-3">
          <label class="form-label fw-semibold">Email</label>
          <div class="input-group">
            <span class="input-group-text"><i class="bi bi-envelope"></i></span>
            <input type="email" class="form-control" id="forgotEmail" placeholder="Enter your email" required>
          </div>
        </div>
        <button type="submit" class="btn btn-primary w-100 fw-semibold">Send Reset Link</button>
      </form>

      <div class="text-center mt-3">
        <a href="#" class="text-decoration-none fw-semibold" data-bs-dismiss="modal">Back to Login</a>
      </div>
    </div>
  </div>
</div>
<!-- Forgot Password Modal -->
<div class="modal fade" id="forgotModal" tabindex="-1" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content p-4 rounded-4 border-0 shadow-sm">
      <h4 class="text-center mb-3 fw-bold">Forgot Password</h4>
      <form id="forgotForm">
        <div class="mb-3">
          <label class="form-label fw-semibold">Email</label>
          <div class="input-group">
            <span class="input-group-text bg-light"><i class="bi bi-envelope"></i></span>
            <input type="email" class="form-control" id="forgotEmail" placeholder="Enter your email" required>
          </div>
        </div>
        <button type="submit" class="btn btn-primary w-100 fw-semibold">Send OTP</button>
      </form>
    </div>
  </div>
</div>

<!-- OTP Modal -->
<div class="modal fade" id="otpModal" tabindex="-1" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content p-4 rounded-4 border-0 shadow-sm">
      <h4 class="text-center mb-3 fw-bold">Enter OTP</h4>
      <form id="otpForm">
        <input type="hidden" id="otpEmail">
        <div class="mb-3">
          <label class="form-label fw-semibold">OTP Code</label>
          <input type="text" class="form-control" id="otpCode" placeholder="Enter your 6-character code" required>
        </div>
        <button type="submit" class="btn btn-primary w-100 fw-semibold">Verify</button>
      </form>
    </div>
  </div>
</div>
<!-- Reset Password Modal -->
<div class="modal fade" id="resetModal" tabindex="-1" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content p-4 rounded-4 border-0 shadow-sm">
      <h4 class="text-center mb-3 fw-bold">Reset Password</h4>
      <p class="text-muted small text-center mb-3">
        Please enter and confirm your new password.
      </p>

      <form id="resetForm">
        <input type="hidden" id="resetEmail">
        <input type="hidden" id="resetOtp">

        <div class="mb-3">
          <label class="form-label fw-semibold">New Password</label>
          <div class="input-group">
            <span class="input-group-text bg-light"><i class="bi bi-lock"></i></span>
            <input type="password" class="form-control" id="newPassword" placeholder="Enter new password" required>
          </div>
        </div>

        <div class="mb-3">
          <label class="form-label fw-semibold">Confirm Password</label>
          <div class="input-group">
            <span class="input-group-text bg-light"><i class="bi bi-lock-fill"></i></span>
            <input type="password" class="form-control" id="confirmPassword" placeholder="Confirm new password" required>
          </div>
        </div>

        <button type="submit" class="btn btn-primary w-100 fw-semibold">Reset Password</button>
      </form>

      <div class="text-center mt-3">
        <a href="#" class="text-decoration-none fw-semibold" data-bs-dismiss="modal" style="color:#2563eb;">Back to Login</a>
      </div>
    </div>
  </div>
</div>

<script src="/Public/js/auth-forgot.js"></script>
