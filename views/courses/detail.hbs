<hr class="my-4">
<h5> Giảng viên</h5>
<div class="mt-3">
  <h6 class="fw-semibold">{{instructor.name}}</h6>
  <p class="text-muted mb-1">👥 {{instructor.total_students}} học viên</p>
  <p>{{instructor.bio}}</p>
</div>

<div class="container py-4">
  <div class="row g-lg-5">

    {{!-- --- Left Column: Course Content --- --}}
    <div class="col-lg-8">

      {{!-- Breadcrumb & Main Info --}}
      <nav aria-label="breadcrumb" class="mb-3">
        <ol class="breadcrumb small bg-light p-2 rounded-pill">
          <li class="breadcrumb-item"><a href="/" class="text-decoration-none">Trang chủ</a></li>
          <li class="breadcrumb-item"><a href="/courses?category={{course.category_id}}" class="text-decoration-none">{{course.category_name}}</a></li>
          <li class="breadcrumb-item active" aria-current="page">{{course.title}}</li>
        </ol>
      </nav>

      <h1 class="h2 fw-bold mb-2">{{course.title}}</h1>
      <p class="lead text-muted mb-3">{{course.description}}</p>

      {{!-- Meta Bar --}}
      {{!-- ... --}}
      <div class="d-flex flex-wrap align-items-center gap-3 small text-muted mb-4">
        {{#if course.is_bestseller}}<span class="badge bg-warning text-dark">Bestseller</span>{{/if}}
        <div><span class="text-warning me-1"><i class="bi bi-star-fill"></i> {{course.average_rating}}</span><span class="fw-semibold">({{course.total_reviews}} đánh giá)</span></div>
        <span><i class="bi bi-people-fill"></i> {{course.enrollment_count}} học viên</span>
        <span>Tạo bởi <a href="#instructor" class="text-decoration-none">{{course.instructor_name}}</a></span>
        <span><i class="bi bi-calendar-check"></i> Cập nhật: {{formatDate course.created_at}}</span>
        <span><i class="bi bi-bar-chart-fill"></i> {{course.level}}</span>
      </div>

      {{!-- Large Image --}}
      <img src="{{course.image_url}}" alt="{{course.title}}" class="img-fluid rounded-3 mb-4 shadow-sm" style="max-height: 450px; width: 100%; object-fit: cover;">


      {{!-- Image Gallery --}}
      {{#if galleryImages.length}}
      <div class="mb-4">
          <h5 class="fw-semibold mb-3">Hình ảnh khác</h5>
          <div class="row g-2 row-cols-2 row-cols-md-3 row-cols-lg-4">
              {{#each galleryImages}}<div class="col"><a href="{{this.image_url}}" target="_blank"><img src="{{this.image_url}}" alt="{{this.description}}" class="img-fluid rounded shadow-sm" style="height: 120px; width: 100%; object-fit: cover;"></a></div>{{/each}}
          </div>
      </div>
      {{/if}}

      {{!-- DETAILED DESCRIPTION --}}
      <div class="card card-body border-0 bg-light mb-4 p-4 shadow-sm">
        <h5 class="fw-semibold mb-3">Chi tiết khóa học</h5>
        {{{course.detail_html}}} {{!-- Triple braces to render HTML --}}
      </div>

      {{!-- COURSE OUTLINE (HIDDEN FOR ANONYMOUS) --}}
      {{#if user}}
        <h4 class="fw-bold mb-3">Nội dung khóa học</h4>
        <div class="text-muted small mb-3">
          {{sections.length}} chương • {{course.total_lectures}} bài học • {{course.total_hours}} giờ tổng thời lượng
        </div>
        <div class="accordion accordion-flush border rounded-3 mb-4 shadow-sm" id="courseAccordion">
          {{#each sections}}
             <div class="accordion-item">
               <h2 class="accordion-header" id="heading-{{section_id}}">
                 <button class="accordion-button collapsed fw-semibold" type="button" data-bs-toggle="collapse" data-bs-target="#collapse-{{section_id}}">
                   Chương {{order_index}}: {{title}}
                   <span class="ms-auto small text-muted me-3">{{lectures.length}} bài</span>
                 </button>
               </h2>
               <div id="collapse-{{section_id}}" class="accordion-collapse collapse" data-bs-parent="#courseAccordion">
                 <div class="accordion-body p-0">
                   <ul class="list-group list-group-flush">
                     {{#each lectures}}
                     <li class="list-group-item d-flex justify-content-between align-items-center py-2 px-3">
                       <div class="text-truncate me-3">
                         <i class="bi bi-play-circle me-2 text-secondary"></i>
                         <span>{{title}}</span>
                       </div>
                       <div class="text-nowrap">
                         {{#if is_preview}}
                           <a href="{{video_url}}" target="_blank" class="badge text-bg-primary text-decoration-none me-2">Xem thử</a>
                           <span class="small text-muted">({{formatDuration duration}})</span>
                         {{else}}
                           {{#if @root.user}}
                             <span class="small text-muted">({{formatDuration duration}})</span>
                           {{else}}
                              <i class="bi bi-lock-fill text-muted me-2" title="Cần đăng nhập/mua khóa học"></i>
                              <span class="small text-muted">({{formatDuration duration}})</span>
                           {{/if}}
                         {{/if}}
                       </div>
                     </li>
                     {{/each}}
                   </ul>
                 </div>
               </div>
             </div>
          {{else}}
           <div class="p-3 text-muted">Nội dung khóa học đang được cập nhật.</div>
          {{/each}}
        </div>
      {{else}} {{!-- Message for anonymous users --}}
        <h4 class="fw-bold mb-3">Nội dung khóa học</h4>
        <div class="alert alert-secondary">
          <i class="bi bi-lock-fill me-1"></i> Bạn cần <a href="/auth/login?redirect={{@root.req.originalUrl}}" class="alert-link">đăng nhập</a> hoặc đăng ký khóa học để xem nội dung chi tiết.
        </div>
      {{/if}}
      {{!-- END COURSE OUTLINE --}}

      {{!-- Instructor Info --}}
       <h4 class="fw-bold mb-3" id="instructor">Thông tin giảng viên</h4>
      <div class="mb-4 p-3 bg-light rounded-3">
        <h5 class="fw-semibold text-primary mb-1">{{course.instructor_name}}</h5>
        <div class="d-flex align-items-center gap-3 small mb-2">
           <img src="https://placehold.co/60x60/7F8C8D/FFFFFF&text={{firstLetter course.instructor_name}}" class="rounded-circle" alt="{{course.instructor_name}}">
           <div class="vstack">
             <div><i class="bi bi-star-fill text-warning me-1"></i> 4.7 Đánh giá giảng viên</div>
             <div><i class="bi bi-people-fill text-success me-1"></i> {{course.instructor_total_students}} Học viên</div>
           </div>
        </div>
        <p class="text-muted small">{{course.instructor_bio}}</p>
      </div>


      <h4 class="fw-bold mb-3">Đánh giá của học viên</h4>
       <div class="d-flex align-items-baseline mb-3 p-3 bg-light rounded-3">
           <span class="display-4 fw-bold text-warning me-3">{{course.average_rating}}</span>
           <div class="lh-1">
             <div class="text-warning">
                {{#each (stars course.average_rating)}}<i class="bi {{this}}"></i>{{/each}}
             </div>
             <div class="small text-muted">Đánh giá trung bình ({{course.total_reviews}} lượt)</div>
           </div>
       </div>
      <div>
        {{#each reviews}}
         <div class="border-top py-3">
          <div class="d-flex align-items-start gap-3">
             <img src="https://placehold.co/40x40/7F8C8D/FFFFFF&text={{firstLetter student_name}}" class="rounded-circle mt-1" alt="{{student_name}}">
            <div class="w-100">
              <div class="d-flex justify-content-between align-items-center mb-1">
                 <span class="fw-semibold">{{student_name}}</span>
                 <span class="small text-muted">{{formatDate created_at}}</span>
              </div>
              <div class="small text-warning mb-1">
                 {{#each (stars rating)}}<i class="bi {{this}}"></i>{{/each}}
              </div>
              <p class="mb-0 small">{{feedback}}</p>
            </div>
          </div>
        </div>
        {{else}}
        <p class="text-muted">Chưa có đánh giá nào.</p>
        {{/each}}
      </div>

    </div> {{!-- End Left Column --}}

    <div class="col-lg-4">
      <div class="sticky-top" style="top: 80px;">

        <div class="card shadow border-0 mb-4 overflow-hidden">
           <div class="ratio ratio-16x9">
              <iframe src="https://www.youtube.com/embed/xBrD8dgfvBg?si=tUHdDxh7lD3a7q4g" title="Mock video preview" frameborder="0" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share" referrerpolicy="strict-origin-when-cross-origin" allowfullscreen></iframe>
          </div>
          <div class="card-body p-3">
            {{!-- Price Display --}}
             <div class="mb-3">
              {{#if (isDiscount course.current_price course.original_price)}}
                 <span class="h2 fw-bold me-2">${{course.current_price}}</span>
                <span class="text-decoration-line-through text-muted">${{course.original_price}}</span>
                <span class="badge bg-danger ms-2">{{discountPercent course.current_price course.original_price}}% OFF</span>
              {{else}}
                <span class="h2 fw-bold">${{course.original_price}}</span>
              {{/if}}
            </div>

            {{! --- Action Buttons ---}}
            <div class="d-grid gap-2 mb-3">
               {{#if user}}
                  {{#if isEnrolled}}
                    <button class="btn btn-success btn-lg" disabled>Đã đăng ký</button>
                  {{else}}
                    <button class="btn btn-primary btn-lg" id="enrollButton" onclick="enrollCourse()">Đăng ký học</button>
                  {{/if}}
                  
                  {{#if isInWatchlist}}
                    <button class="btn btn-outline-danger" id="toggleWatchlist">
                      <i class="bi bi-heart-fill me-1"></i> Bỏ khỏi yêu thích
                    </button>
                  {{else}}
                    <button class="btn btn-outline-secondary" id="toggleWatchlist">
                      <i class="bi bi-heart me-1"></i> Thêm vào yêu thích
                    </button>
                  {{/if}}
               {{else}}
                 <a href="/auth/login?redirect=/courses/{{course.course_id}}" class="btn btn-primary btn-lg">Đăng nhập để học</a>
               {{/if}}
            </div>

            <script>
            async function enrollCourse() {
              try {
                const response = await fetch(`/courses/{{course.course_id}}/enroll`, {
                  method: 'POST',
                  headers: { 'Content-Type': 'application/json' },
                  credentials: 'same-origin' 
                });
                
                const data = await response.json();
                if (response.ok) {
                  alert('Đăng ký khóa học thành công!');
                  window.location.href = data.redirect;
                } else {
                  alert(data.error || 'Có lỗi xảy ra');
                  if (data.error === 'Vui lòng đăng nhập để đăng ký khóa học') {
                    window.location.href = '/auth/login?redirect=/courses/{{course.course_id}}';
                  }
                }
              } catch (error) {
                console.error('Error:', error);
                alert('Có lỗi xảy ra khi đăng ký khóa học');
              }
            };

            document.getElementById('toggleWatchlist')?.addEventListener('click', async () => {
              try {
                const action = {{#if isInWatchlist}}'unfavorite'{{else}}'favorite'{{/if}};
                console.log('Updating watchlist - Action:', action);
                const response = await fetch(`/courses/{{course.course_id}}/${action}`, {
                  method: 'POST',
                  headers: { 
                    'Content-Type': 'application/json'
                  },
                  credentials: 'same-origin'
                });
                
                if (response.ok) {
                  window.location.reload();
                } else {
                  const text = await response.text();
                  console.error('Server response:', text);
                  try {
                    const data = JSON.parse(text);
                    if (data.error === 'Vui lòng đăng nhập') {
                      window.location.href = '/auth/login?redirect=/courses/{{course.id}}';
                    } else {
                      alert(data.error || 'Có lỗi xảy ra khi cập nhật danh sách yêu thích');
                    }
                  } catch (e) {
                    alert('Có lỗi xảy ra khi cập nhật danh sách yêu thích');
                  }
                }
              } catch (error) {
                console.error('Error:', error);
                alert('Có lỗi xảy ra');
              }
            });
            </script>
            <p class="small text-center text-muted mb-3">Đảm bảo hoàn tiền trong 30 ngày</p>

             <h6 class="fw-semibold small">Khóa học này bao gồm:</h6>
            <ul class="list-unstyled small text-muted mb-0">
              <li class="mb-1"><i class="bi bi-camera-video me-2 text-primary"></i> {{course.total_hours}} giờ video theo yêu cầu</li>
              <li class="mb-1"><i class="bi bi-journal-text me-2 text-primary"></i> {{course.total_lectures}} bài học</li>
              <li class="mb-1"><i class="bi bi-phone me-2 text-primary"></i> Truy cập trên di động và TV</li>
              <li class="mb-1"><i class="bi bi-infinity me-2 text-primary"></i> Truy cập trọn đời</li>
              <li class="mb-1"><i class="bi bi-patch-check me-2 text-primary"></i> Chứng chỉ hoàn thành</li>
            </ul>

          </div>
        </div>

        {{#if relatedCourses.length}}
        <div class="card shadow-sm border-0">
          <div class="card-header bg-light fw-semibold">Khóa học liên quan</div>
          <div class="list-group list-group-flush">
            {{#each relatedCourses}}
             <a href="/courses/{{course_id}}" class="list-group-item list-group-item-action d-flex align-items-center gap-3 py-2">
               <img src="{{image_url}}" class="rounded" width="50" height="50" alt="{{title}}" style="object-fit: cover;">
                <div class="flex-fill overflow-hidden">
                  <div class="small fw-semibold text-truncate">{{title}}</div>
                  <div class="xsmall text-muted text-truncate">{{instructor_name}}</div>
                   <div class="xsmall text-warning"><i class="bi bi-star-fill me-1"></i>{{average_rating}}</div>
                 </div>
                 <div class="fw-bold small ms-auto">${{current_price}}</div>
              </a>
            {{/each}}
          </div>
        </div>
        {{/if}}

      </div> 
    </div> 

  </div>
</div> 

{{#section "js"}}
<script>
  document.addEventListener('DOMContentLoaded', () => {

    const favoriteContainer = document.getElementById('favorite-button-container');

    if (favoriteContainer) {

      const initialForm = favoriteContainer.querySelector('form');
      let courseId = null;
      if (initialForm && initialForm.action) {
         const actionParts = initialForm.action.split('/');
         if (actionParts.length >= 3) { courseId = actionParts[actionParts.length - 2]; }
      }
      if (!courseId) {
           console.error(" ERROR: Could not extract course ID from form action.");
           courseId = '{{course.course_id}}'; // Fallback
           if (!courseId || courseId === 'undefined' || courseId === '') {
                console.error(" ERROR: Fallback course ID is also invalid."); return;
           }
           console.warn("Falling back to Handlebars variable for course ID:", courseId);
      }


      const updateButtonAppearance = (isNowFavorite) => {
        favoriteContainer.style.opacity = '0.5'; 
        favoriteContainer.style.pointerEvents = 'none';

        if (isNowFavorite) {
          favoriteContainer.innerHTML = `
            <form action="/courses/${courseId}/unfavorite" method="POST" id="unfavorite-form">
              <button type="submit" class="btn btn-outline-danger w-100">
                  <i class="bi bi-heart-fill me-1"></i> Bỏ yêu thích
              </button>
            </form>
          `;
        } else {
          favoriteContainer.innerHTML = `
            <form action="/courses/${courseId}/favorite" method="POST" id="favorite-form">
              <button type="submit" class="btn btn-outline-secondary w-100">
                  <i class="bi bi-heart me-1"></i> Thêm vào yêu thích
              </button>
            </form>
          `;
        }
        setTimeout(() => { 
            favoriteContainer.style.opacity = '1';
            favoriteContainer.style.pointerEvents = 'auto';
        }, 300);
      };

      favoriteContainer.addEventListener('submit', async (event) => {
         event.preventDefault(); 

         if (event.target.matches('#favorite-form, #unfavorite-form')) {

              const form = event.target;
              const url = form.action;
              const method = form.method.toUpperCase();
              let isAddingFavorite = (form.id === 'favorite-form');

              const submitButton = form.querySelector('button');
              if(submitButton) submitButton.disabled = true;
              favoriteContainer.style.opacity = '0.5';
              favoriteContainer.style.pointerEvents = 'none';


              try {
                  const response = await fetch(url, {
                      method: method,
                      headers: { 'Accept': 'application/json' }, 
                  });


                  if (response.ok) {
                      updateButtonAppearance(isAddingFavorite);
                  } else {
                      console.error(` Request to ${url} failed with status ${response.status}.`);
                      alert(`Lỗi ${response.status}: Không thể cập nhật danh sách yêu thích. Trang sẽ được tải lại.`);
                      window.location.reload(); 
                  }
              } catch (error) {
             
                  console.error(` Network error during fetch to ${url}:`, error);
                  alert("Lỗi mạng: Không thể kết nối. Trang sẽ được tải lại.");
                  window.location.reload(); 
              } finally {
                 if(submitButton) submitButton.disabled = false;
                 favoriteContainer.style.opacity = '1';
                 favoriteContainer.style.pointerEvents = 'auto';
              }
          } 
      });

    } else {
      console.error(" ERROR: Favorite button container (#favorite-button-container) was NOT found.");
    }
  });
</script>
{{/section}}